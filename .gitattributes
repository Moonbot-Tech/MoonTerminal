* text=auto eol=lf
/.gitattributes text eol=lf
*.sh text eol=lf
# Makefile requires LF (make breaks on \r on macOS/Linux).
Makefile text eol=lf

# Generated by `make tour` and compared byte-for-byte by the CI gate: a CRLF
# checkout would make every line of it read as drift.
/docs/tour/index.html text eol=lf

*.bmp binary
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.ttf binary
*.webp binary
